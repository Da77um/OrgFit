# Development administrator bootstrap. Copy to `.env.bootstrap`, which git
# ignores, and fill it in there. Never commit a populated copy, never paste a
# value from it into documentation, a screenshot or a chat message.
#
#   node --env-file=.env.bootstrap --import tsx scripts/bootstrap-dev-admin.ts
#
# The script refuses to run with NODE_ENV=production or against a database host
# that is not loopback, because the account it creates has a password somebody
# typed and satisfies no second factor. It is a development convenience, not a
# provisioning mechanism: real staff accounts come from the identity provider
# P-005 selects, or from an invitation issued by an authenticated Super Admin.

# The operator migration connection, exactly as scripts/migrate.ts uses.
MIGRATION_DATABASE_URL=postgresql://orgfit_migrator:CHANGE_ME@127.0.0.1:5432/orgfit

BOOTSTRAP_ADMIN_EMAIL=admin@orgfit.com
# At least 8 characters with a letter and a digit. Supply it here; the script
# never echoes it and no page in the product ever displays or prefills it.
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=مسؤول النظام
