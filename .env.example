# Copy locally; never commit populated credentials. See docs/orgfit/foundation.md.
STAFF_ORIGIN=http://127.0.0.1:3000
RESPONDENT_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://orgfit_staff:CHANGE_ME@127.0.0.1:5432/orgfit
AUTH_DATABASE_URL=postgresql://orgfit_auth:CHANGE_ME@127.0.0.1:5432/orgfit
OIDC_ISSUER=https://identity.example.invalid
OIDC_CLIENT_ID=orgfit
OIDC_CLIENT_SECRET=CHANGE_ME
# Exact provider MFA acr values; verified against ID-token claims.
OIDC_MFA_ACR=urn:example:mfa

# Directory imports only: 64 lowercase hex characters from a random 32-byte key.
# Keep outside source control; separate from future survey/intake keys.
IMPORT_ENCRYPTION_KEY=CHANGE_ME
# Development only: set the same absolute private directory for staff and cleanup.
# IMPORT_LOCAL_DIRECTORY=C:/private/orgfit-imports
# Production requires a private S3 bucket; never expose these to respondent.
# IMPORT_S3_BUCKET=private-import-bucket
# AWS_REGION=chosen-region
# IMPORT_S3_ENDPOINT=https://your-private-s3-compatible-endpoint
# Supply AWS credentials through the standard server credential provider.
# Configure imports/ lifecycle expiration after 1 day, including prior versions.

# Invitations only: 64 lowercase hex characters from a random 32-byte key.
# Tokens are never stored; this key computes the persisted keyed digest.
# Rotating it invalidates every outstanding link, so plan a rotation window.
INVITATION_DIGEST_KEY=CHANGE_ME
# Recorded next to each digest so a future key rotation stays auditable.
INVITATION_DIGEST_KEY_VERSION=v1
# Manual link exports only: separate 64-hex key, never reused from imports.
LINK_EXPORT_ENCRYPTION_KEY=CHANGE_ME
# Development only: private directory for short-lived encrypted link exports.
# LINK_EXPORT_LOCAL_DIRECTORY=C:/private/orgfit-link-exports
# Production requires a private bucket with a 1-day lifecycle on link-exports/.
# LINK_EXPORT_S3_BUCKET=private-link-export-bucket
# LINK_EXPORT_S3_ENDPOINT=https://your-private-s3-compatible-endpoint

# --- Phase 07: respondent gateway, key custody and the privacy processor ---
# These belong to DIFFERENT processes. The staff application refuses to start if
# it finds any of the gateway, processor, operator or custodian-secret values,
# because holding two of them at once collapses a privacy boundary.
#
# Respondent gateway process only (apps/respondent). It holds no table privilege
# and can execute only the session-scoped intake routines.
# GATEWAY_DATABASE_URL=postgresql://orgfit_gateway:CHANGE_ME@127.0.0.1:5432/orgfit
#
# Key custody. Generate one custodian key pair per environment:
#   node --import tsx -e "import('./src/key-custody').then(async m => console.log(await m.generateCustodianKeypair()))"
# The staff application receives ONLY the public half, so a launch can seal a
# campaign private key it can never open again. The secret half goes to the
# privacy processor alone and must never appear in a web process environment.
CAMPAIGN_KEY_CUSTODY_PUBLIC_KEY=CHANGE_ME
# Private directory holding sealed campaign private keys. The staff process
# writes here; only the processor reads. Development stand-in for a real managed
# key service, which remains production input P-003.
# CAMPAIGN_KEY_CUSTODY_DIRECTORY=C:/private/orgfit-key-custody

# --- Phase 11: report artifacts and named participation exports ---
# The staff application needs BOTH keys below: it decrypts a finished report to
# serve an authorized download, and it writes the named participation list. It
# must never hold REPORT_DATABASE_URL — that belongs to the renderer process and
# the staff configuration guard refuses to start if it finds it.
#
# Rendered PDF/XLSX artifacts only: 64 lowercase hex characters, never reused
# from imports, link exports or intake.
REPORT_ENCRYPTION_KEY=CHANGE_ME
# Development only: private directory for short-lived encrypted report artifacts.
# REPORT_LOCAL_DIRECTORY=C:/private/orgfit-reports
# Production requires a private bucket with a 1-day lifecycle on reports/.
# REPORT_S3_BUCKET=private-report-bucket
# REPORT_S3_ENDPOINT=https://your-private-s3-compatible-endpoint

# Named participation lists only: a SEPARATE 64-hex key from the report key, so
# the process that draws an assessment report cannot decrypt a file of names.
PARTICIPATION_EXPORT_ENCRYPTION_KEY=CHANGE_ME
# PARTICIPATION_EXPORT_LOCAL_DIRECTORY=C:/private/orgfit-participation-exports
# PARTICIPATION_EXPORT_S3_BUCKET=private-participation-export-bucket
# PARTICIPATION_EXPORT_S3_ENDPOINT=https://your-private-s3-compatible-endpoint

# Optional report theme override. A JSON object of token names to safe values;
# unknown names and unsafe values are ignored. See src/report-theme.ts.
# REPORT_THEME={"accent":"#1f4b73","font-size-base":"10pt"}

# --- Phase 12: visit attachments ---
# The staff application needs this key: it encrypts an uploaded consulting file
# and decrypts it again to serve an authorized download. It must never hold
# SCANNER_DATABASE_URL — that belongs to the scanner process, and the staff
# configuration guard refuses to start if it finds it.
#
# Visit attachments only: 64 lowercase hex characters, never reused from
# imports, link exports, intake, reports or participation exports.
ATTACHMENT_ENCRYPTION_KEY=CHANGE_ME
# Development only: private directory for encrypted visit attachments.
# ATTACHMENT_LOCAL_DIRECTORY=C:/private/orgfit-attachments
# Production requires a private bucket. Attachments are retained for the
# engagement, not for a day, so configure a lifecycle rule on attachments/ that
# matches the retention window in src/attachment-types.ts (365 days by default)
# rather than the one-day rule used for reports and exports.
# ATTACHMENT_S3_BUCKET=private-attachment-bucket
# ATTACHMENT_S3_ENDPOINT=https://your-private-s3-compatible-endpoint
