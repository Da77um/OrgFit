# Operator scripts only. Never pass this file to a web process.
MIGRATION_DATABASE_URL=postgresql://orgfit_migrator:CHANGE_ME@127.0.0.1:5432/orgfit
BOOTSTRAP_ISSUER=https://identity.example.invalid
BOOTSTRAP_SUBJECT=EXACT_APPROVED_PROVIDER_SUBJECT
BOOTSTRAP_EMAIL=admin@example.invalid
BOOTSTRAP_NAME=OrgFit administrator

# --- Phase 07 privacy processor and anonymous store (operator only) ---
# The privacy processor runs as its own identity with its own two databases.
# No staff, auth or gateway credential may connect to the anonymous database.
PROCESSOR_DATABASE_URL=postgresql://orgfit_processor:CHANGE_ME@127.0.0.1:5432/orgfit
ANONYMOUS_DATABASE_URL=postgresql://orgfit_processor:CHANGE_ME@127.0.0.1:5432/orgfit_anonymous
ANONYMOUS_MIGRATION_DATABASE_URL=postgresql://orgfit_anon_migrator:CHANGE_ME@127.0.0.1:5432/orgfit_anonymous
# The custodian SECRET key. This is the only place it may appear. It is what
# decrypts accepted answers, so its custody is the trust assumption the whole
# anonymity baseline rests on (P-003).
CAMPAIGN_KEY_CUSTODY_SECRET_KEY=CHANGE_ME
CAMPAIGN_KEY_CUSTODY_PUBLIC_KEY=CHANGE_ME
CAMPAIGN_KEY_CUSTODY_DIRECTORY=C:/private/orgfit-key-custody

# --- Phase 11 report renderer (operator only) ---
# The renderer runs as its own identity. orgfit_report holds no table privilege
# anywhere, has no CONNECT on the anonymous database, and can execute only the
# report job routines of migration 014. The process must NOT hold a staff, auth,
# processor, gateway or custody credential, nor the import, link-export or
# participation-export keys: src/report-db.ts refuses to start if it finds one.
REPORT_DATABASE_URL=postgresql://orgfit_report:CHANGE_ME@127.0.0.1:5432/orgfit
# The renderer writes artifacts with the same key the staff process reads them
# with. It never holds PARTICIPATION_EXPORT_ENCRYPTION_KEY.
REPORT_ENCRYPTION_KEY=CHANGE_ME
# REPORT_LOCAL_DIRECTORY=C:/private/orgfit-reports
# The PDF renderer needs a Chromium build: `npx playwright install chromium`.

# --- Phase 12 attachment scanner (operator only) ---
# The scanner runs as its own identity. orgfit_scanner holds no table privilege
# anywhere, has no CONNECT on the anonymous database, and can execute only the
# three attachment routines of migration 015 (claim, record, expire). The
# process must NOT hold a staff, auth, processor, gateway, renderer or custody
# credential, nor the import, link-export, participation-export or report keys:
# src/scanner-db.ts refuses to start if it finds one.
SCANNER_DATABASE_URL=postgresql://orgfit_scanner:CHANGE_ME@127.0.0.1:5432/orgfit
# The scanner reads uploaded bytes with the same key the staff process wrote
# them with, and holds nothing else.
ATTACHMENT_ENCRYPTION_KEY=CHANGE_ME
# ATTACHMENT_LOCAL_DIRECTORY=C:/private/orgfit-attachments
# Two separate controls decide a file (Post-Audit Repair Pass 4): type, size,
# container and active-document checks, and a malware engine. The engine:
#   ATTACHMENT_SCAN_ENGINE=clamd                  a maintained engine via clamd's INSTREAM protocol
#   ATTACHMENT_SCAN_CLAMD_ADDRESS=unix:/run/clamav/clamd.sock   or tcp://127.0.0.1:3310 (loopback only in production)
#   ATTACHMENT_SCAN_TIMEOUT_SECONDS=60
# Unset outside production means the development heuristic (the EICAR test
# string only) and every run says it is NOT a malware scan. In production an
# unset engine or the heuristic is refused before any file is claimed. Which
# engine, its hosting and signature updates remain production input P-010.
# ATTACHMENT_SCAN_ENGINE=

# ---- Phase 14: retention, tombstones, backups and alerting -------------------
# npm run retention:run      daily at least (policy durations are NOT approved; P-004)
# npm run tombstones:ship    at least as often as the backup RPO
# npm run restore:reapply -- --mark   first step on a restored environment
# npm run restore:reapply    replays the ledger, then opens the environment
# npm run ops:check          every few minutes; exit 2 means a critical alert
# npm run intake:erase       restore incident only, after the owner's decision (incident-runbook §10)
# The ledger MUST live outside the database, outside database backups, with its
# own retention of at least backup retention + 1 day. Production (Pass 4): a
# bucket with Object Lock enabled; every batch and seal is a conditional create
# with a SHA-256 checksum and a COMPLIANCE retention of at least 36 days.
# TOMBSTONE_LEDGER_S3_BUCKET=private-tombstone-ledger
# TOMBSTONE_LEDGER_S3_ENDPOINT=https://your-private-s3-compatible-endpoint
# TOMBSTONE_LEDGER_S3_PREFIX=tombstones/
# TOMBSTONE_LEDGER_OBJECT_LOCK_DAYS=36
# Development only (refused in production):
TOMBSTONE_LEDGER_DIRECTORY=CHANGE_ME
# Newest file age here drives BACKUP_STALE_OR_MISSING; the volume at OPS_DISK_PATH
# drives LOW_DISK.
# BACKUP_DIRECTORY=CHANGE_ME
# OPS_DISK_PATH=CHANGE_ME

# ---- Post-Audit Repair Pass 3: supervised jobs ---------------------------------
# npm run jobs:supervise -- --env-dir <dir> --state-dir <dir>
# The supervisor does NOT read this file. <env-dir> holds one file per job
# process — processor.env, report.env, scanner.env, operator.env — each with
# only the variables deploy/processes.json lists for that process, exactly as
# release preflight validates them. Never combine them into one file.
# The supervisor's own environment may hold only alert settings, and it refuses
# to start if it holds any database URL, key or client secret:
#   ALERT_SINK=none            none | console | file | webhook
#   ALERT_FILE=                with ALERT_SINK=file
#   ALERT_WEBHOOK_URL=         https only in production; with ALERT_SINK=webhook
#   ALERT_WEBHOOK_TOKEN=       optional bearer token; never logged
#   ALERT_DELIVERY_ENABLED=    must be "true" before a webhook is used
#   ALERT_REPEAT_SECONDS=3600  repeat interval for a still-open critical alert
# Withdrawing a release when no Super Admin can sign in (operator credential):
#   npm run release:revoke -- --organization <uuid> --campaign <uuid> --approver <super admin email> \
#     --reason-code PRIVACY_INCIDENT --reason "<reason>" --incident <reference> --confirm <fingerprint prefix>