{
  "name": "orgfit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @orgfit/staff",
    "dev:respondent": "npm run dev -w @orgfit/respondent",
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:e2e": "playwright test",
    "test:production": "tsx tests/production-smoke.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:directory": "tsx --test tests/directory.test.ts",
    "imports:expire": "tsx scripts/expire-imports.ts",
    "instruments:seed": "tsx scripts/seed-instruments.ts",
    "test:instruments": "tsx --test tests/instruments.test.ts",
    "test:scoring": "tsx --test tests/scoring.test.ts",
    "test:scoring-db": "tsx --test tests/scoring-database.test.ts",
    "test:checkpoint-b": "tsx --test tests/checkpoint-b.test.ts",
    "test:campaigns": "tsx --test tests/campaigns.test.ts",
    "campaigns:normalize": "tsx scripts/close-campaigns.ts",
    "links:expire": "tsx scripts/expire-link-exports.ts",
    "db:migrate-anonymous": "tsx scripts/migrate-anonymous.ts",
    "privacy:process": "tsx scripts/process-campaigns.ts",
    "drafts:expire": "tsx scripts/expire-drafts.ts",
    "test:respondent": "tsx --test tests/respondent.test.ts",
    "test:privacy": "tsx --test tests/privacy.test.ts",
    "test:checkpoint-c": "tsx --test tests/checkpoint-c.test.ts",
    "publication:release": "tsx scripts/publish-campaigns.ts",
    "test:disclosure": "tsx --test tests/disclosure.test.ts",
    "test:publication": "tsx --test tests/publication.test.ts",
    "test:recommendations": "tsx --test tests/recommendations.test.ts",
    "test:checkpoint-d": "tsx --test tests/checkpoint-d.test.ts",
    "test:comparison": "tsx --test tests/comparison.test.ts",
    "test:history": "tsx --test tests/history.test.ts",
    "reports:generate": "tsx scripts/generate-reports.ts",
    "reports:expire": "tsx scripts/expire-reports.ts",
    "test:reports": "tsx --test --test-concurrency=1 tests/reports.test.ts",
    "test:checkpoint-e": "tsx --test --test-concurrency=1 tests/checkpoint-e.test.ts",
    "attachments:scan": "tsx scripts/scan-attachments.ts",
    "attachments:expire": "tsx scripts/expire-attachments.ts",
    "test:visits": "tsx --test --test-concurrency=1 tests/visits.test.ts",
    "showcase": "tsx scripts/showcase.ts",
    "db:provision-dev": "tsx scripts/provision-dev.ts",
    "db:bootstrap-dev-admin": "tsx scripts/bootstrap-dev-admin.ts",
    "test:access": "tsx --test --test-concurrency=1 tests/access.test.ts",
    "test:localization": "tsx --test tests/localization.test.ts",
    "retention:run": "tsx scripts/retention.ts",
    "tombstones:ship": "tsx scripts/ship-tombstones.ts",
    "restore:reapply": "tsx scripts/restore-reapply.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "test:operations": "tsx --test --test-concurrency=1 tests/operations.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1128.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/zain": "^5.3.0",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "kysely": "0.29.5",
    "libsodium-wrappers": "0.8.4",
    "next": "16.3.4",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.63.0",
    "@types/libsodium-wrappers": "0.7.14",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "jose": "6.2.12",
    "pdfjs-dist": "^6.3.289",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
